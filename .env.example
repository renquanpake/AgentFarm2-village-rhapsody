# AgentFarm2 环境变量示例（复制为 .env 或 .env.local 并填值；.env* 均已 gitignore，勿提交真实密钥）
# 平台约束：服务端绝不托管池化 LLM 密钥（M7：玩家自带 Key，AES-256-GCM 加密保管）。

# LLM 托管大脑（服务端启动托管 agent 子进程时注入；缺省则托管不可用，玩家在线自驱）
# 由房主/玩家在游戏内 /af/agent-provider 配置（key 不回显，落 data/agent-provider.json）
AF_LLM_URL=
AF_LLM_KEY=
AF_LLM_MODEL=deepseek-v4-flash

# 运行
# PORT=8080
# AF_SLOT=1
# AF_DATA_DIR=/data        # 容器部署：持久卷
# AF_NO_TUNNEL=1          # 关闭自动内网穿透（测试/局域网部署）
# AF_NO_GIT=1            # 关闭 git 自动备份（容器 volume 直存时）
# AF_GROW_MS=600000      # 作物 1 天 = 10 分钟（调试可调小）
# AF_WS_HEARTBEAT_MS=30000

# 玩家自带 Key（M7，账号级 AES-256-GCM 保管；此处为服务端自身解密密钥，勿泄露）
# AF_AES_KEY=

# 开发者本地调试工具用（tools/*.mjs）——真实值放 .env.local，勿提交
# 17 个调试脚本经 tools/env.mjs 的 loadLocalEnv() 自动加载 .env / .env.local（进程已有 env 优先）
DEEPSEEK_API_KEY=your-key-here
AGNES_API_KEY=your-key-here

# C8 生图管线（tools/art-gen.mjs，OpenAI 兼容 /images/generations 端点）
USER_IMG_BASE_URL=your-image-api-base-url/v1
USER_IMG_API_KEY=your-image-api-key
USER_IMG_MODEL=your-image-model
