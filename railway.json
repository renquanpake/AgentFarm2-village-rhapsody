{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node src/index.ts",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "parallelBuilds": true
  }
}